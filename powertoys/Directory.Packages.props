<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dock bands need SDK 0.9.260303001 or later (ICommandProvider3). -->
    <PackageVersion Include="Microsoft.CommandPalette.Extensions" Version="0.12.260812002" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260903100" />
    <PackageVersion Include="Shmuelie.WinRTServer" Version="2.1.1" />
  </ItemGroup>
</Project>
